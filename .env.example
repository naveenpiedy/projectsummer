# Copy to .env and fill in. None of these are required to query an existing
# database -- they are only needed for ingestion and RSS polling.

# TMDB API read-access token (https://www.themoviedb.org/settings/api)
TMDB_API_KEY=

# Your Letterboxd username, used to build RSS feed URLs.
# Optional: if unset, the username from your imported profile.csv is used.
LETTERBOXD_USERNAME=

# Override where the DuckDB file lives. Defaults to a per-user data directory.
# LETTERBOXD_DB=./data/letterboxd.duckdb
