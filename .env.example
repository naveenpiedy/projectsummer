# Copy to .env and fill in. Nothing here is needed to import an export or to
# query a database that already exists.

# TMDB API Read Access Token -- the long one, not the short v3 key.
# Needed by `summer enrich`. Free: https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# Your Letterboxd username, used to build RSS feed URLs.
# Optional: if unset, the username from your imported profile.csv is used.
LETTERBOXD_USERNAME=

# Where the DuckDB file lives. Defaults to a per-user data directory.
# LETTERBOXD_DB=./data/letterboxd.duckdb

# Extra directories to load your own plugins from, separated by the platform
# path separator (';' on Windows, ':' elsewhere).
# LETTERBOXD_PLUGIN_PATH=./my-plugins

# Set to true to serve the MCP server with no tool that changes anything:
# no sync, no list building, no marking lists ranked.
# LETTERBOXD_MCP_READ_ONLY=true
